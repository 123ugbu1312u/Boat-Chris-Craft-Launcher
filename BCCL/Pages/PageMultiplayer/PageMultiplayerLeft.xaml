<local:MyPageLeft x:Class="BCCL.PageMultiplayerLeft"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BCCL" Width="180">
    <StackPanel x:Name="PanItem" Margin="0,18,0,0">
        <TextBlock Text="MULTIPLAYER" Opacity="0.55" FontSize="11" Margin="16,0,12,10" />
        <local:MyListItem x:Name="ItemLobby" Title="联机大厅" Info="和朋友一起玩" SvgIcon="lucide/network"
            Type="RadioBox" Height="58" IsScaleAnimationEnabled="False" Check="PageCheck" />
        <local:MyListItem x:Name="ItemExtras" Title="其他功能" Info="聊天、文件、语音与屏幕" SvgIcon="lucide/message-circle"
            Type="RadioBox" Height="58" IsScaleAnimationEnabled="False" Check="PageCheck" />
        <TextBlock Text="联机只需三步" FontSize="14" Margin="16,24,12,8" />
        <TextBlock Text="创建或加入大厅&#10;分享邀请，等待朋友&#10;连接游戏，开始游玩"
            TextWrapping="Wrap" Opacity="0.65" LineHeight="25" Margin="16,0,16,0" />
        <TextBlock Text="切换页面会保留联机，退出启动器会断开。" TextWrapping="Wrap" Opacity="0.55"
            LineHeight="22" Margin="16,18,16,0" />
    </StackPanel>
</local:MyPageLeft>
