<local:MyPageRight x:Class="BCCL.PageLaunchRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:BCCL"> <!-- 不知道为啥只有这个文件不能在 XAML 设置 PanScroll -->
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="26,18,22,20" Grid.IsSharedSizeScope="True">
            <local:MyCard x:Name="WorkspaceHeroCard" Margin="0,0,0,20" HasMouseAnimation="False">
                <Grid MinHeight="222" ClipToBounds="True" SizeChanged="WorkspaceHero_SizeChanged">
                    <Grid IsHitTestVisible="False" HorizontalAlignment="Right" Width="190" Opacity="0.5">
                        <Ellipse Width="210" Height="210" Margin="60,-65,-80,0" Stroke="{DynamicResource ColorBrush4}" StrokeThickness="1" />
                        <Ellipse Width="150" Height="150" Margin="60,-65,-80,0" Stroke="{DynamicResource ColorBrush4}" StrokeThickness="1" />
                        <Path Data="M0,55 L55,25 110,55 55,85 Z M55,85 L55,145 110,115 110,55 M55,145 L0,115 0,55 M0,55 L55,85" Stroke="{DynamicResource ColorBrush3}" StrokeThickness="1.5" Width="110" Height="145" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="30,0,0,20" />
                    </Grid>
                    <StackPanel Margin="26,25,26,24">
                        <TextBlock Text="BCCL  /  WORKSPACE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush3}" />
                        <TextBlock Text="{DynamicResource Workbench.Hero}" FontSize="32" LineHeight="42" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrushGray1}" Margin="0,16,0,16" />
                        <TextBlock Text="{DynamicResource Workbench.Instance}" Foreground="{DynamicResource ColorBrushGray3}" FontSize="11" />
                        <TextBlock x:Name="LabWorkspaceVersion" FontSize="14" FontWeight="SemiBold" Margin="0,6,90,0" Foreground="{DynamicResource ColorBrush2}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <DockPanel Margin="2,0,2,12">
                <TextBlock Text="{DynamicResource Workbench.Quick}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrushGray1}" />
                <TextBlock Text="{DynamicResource Workbench.QuickHint}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ColorBrushGray3}" />
            </DockPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <local:MyButton Text="{DynamicResource Workbench.Library}" Height="58" Margin="0,0,6,12" Tag="instances" Click="WorkspaceAction_Click" ToolTip="{DynamicResource Workbench.LibraryHint}" />
                <local:MyButton Grid.Column="1" Text="{DynamicResource Workbench.Install}" Height="58" Margin="6,0,0,12" Tag="install" Click="WorkspaceAction_Click" ToolTip="{DynamicResource Workbench.InstallHint}" />
                <local:MyButton Grid.Row="1" Text="{DynamicResource Workbench.Mods}" Height="58" Margin="0,0,6,12" Tag="mods" Click="WorkspaceAction_Click" />
                <local:MyButton Grid.Row="1" Grid.Column="1" Text="{DynamicResource Workbench.Packs}" Height="58" Margin="6,0,0,12" Tag="packs" Click="WorkspaceAction_Click" />
                <local:MyButton Grid.Row="2" Text="{DynamicResource Workbench.Tasks}" Height="44" Margin="0,0,6,0" Tag="tasks" Click="WorkspaceAction_Click" />
                <local:MyButton Grid.Row="2" Grid.Column="1" Text="{DynamicResource Workbench.Setup}" Height="44" Margin="6,0,0,0" Tag="setup" Click="WorkspaceAction_Click" />
            </Grid>
            <StackPanel x:Name="PanCustom" />
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Launch.Right.CommunityHint.Title}" x:Name="PanHint">
                <local:MyIconButton LogoScale="1.1"
                                    SvgIcon="lucide/x"
                                    Height="20" Width="20" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    x:Name="BtnHintClose"
                                    Click="BtnHintClose_Click" />
                <StackPanel Margin="25,38,23,15">
                    <TextBlock x:Name="LabHint1" TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" />
                    <TextBlock x:Name="LabHint2" TextWrapping="Wrap" Margin="0,0,0,2" FontSize="13.5" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Launch.Right.Log.Title}" x:Name="PanLog">
                <TextBlock x:Name="LabLog" Margin="20,38,20,18" TextTrimming="None" TextWrapping="Wrap" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
