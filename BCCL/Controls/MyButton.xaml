<Border x:Class="BCCL.MyButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BCCL"
        FocusVisualStyle="{x:Null}" x:Name="PanBack"
        CornerRadius="3" Focusable="True" UseLayoutRounding="False" SnapsToDevicePixels="False"
        Background="{StaticResource ColorBrushSemiTransparent}">
    <Border CornerRadius="{Binding CornerRadius, ElementName=PanBack}" x:Name="PanFore" BorderThickness="1" BorderBrush="{DynamicResource ColorBrush1}"
            RenderTransformOrigin="0.5,0.5" Background="{DynamicResource ColorBrushHalfWhite}">
        <Border.RenderTransform>
            <ScaleTransform />
        </Border.RenderTransform>
        <Grid>
        <Border CornerRadius="{Binding CornerRadius, ElementName=PanBack}" IsHitTestVisible="False"
                Background="{DynamicResource GlassCardSheen}" Visibility="{DynamicResource GlassButtonVisibility}" />
        <local:LiquidGlassSurface x:Name="ButtonOptics" Radius="{Binding CornerRadius.TopLeft, ElementName=PanBack}"
                                 InteractionHost="{Binding ElementName=PanBack}" Visibility="{DynamicResource GlassButtonVisibility}" />
        <TextBlock TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" TextTrimming="None"
                   HorizontalAlignment="Center" x:Name="LabText" VerticalAlignment="Center"
                   RenderTransformOrigin="0.5,0.5"
                   Foreground="{Binding BorderBrush, ElementName=PanFore}" FontSize="13"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <ScaleTransform />
            </TextBlock.RenderTransform>
        </TextBlock>
        </Grid>
    </Border>
</Border>
