<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <Target Name="UseBCCLNativeAppHost"
          BeforeTargets="_CreateAppHost"
          DependsOnTargets="ResolveFrameworkReferences"
          Condition="'$(MSBuildProjectName)' == 'BCCL' and '$(RuntimeIdentifier)' == 'win-x64' and '$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'false'">
    <PropertyGroup>
      <BCCLHostingPack>$([System.IO.Path]::GetDirectoryName('$(AppHostSourcePath)'))</BCCLHostingPack>
      <BCCLNativeAppHost>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'BCCL.NativeAppHost.exe'))</BCCLNativeAppHost>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildProjectDirectory)\..\scripts\Packaging\Build-NativeAppHost.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)\Windows\Startup\NativeAppHost.cpp&quot; -Output &quot;$(BCCLNativeAppHost)&quot; -HostingPack &quot;$(BCCLHostingPack)&quot;" />
    <PropertyGroup>
      <AppHostSourcePath>$(BCCLNativeAppHost)</AppHostSourcePath>
    </PropertyGroup>
  </Target>
</Project>
