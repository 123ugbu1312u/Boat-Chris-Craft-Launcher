<local:MyPageRight x:Class="BCCL.PageToolsDailyRecommendations"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:BCCL"
                   xmlns:svg="clr-namespace:BCCL.Core.UI.Controls.SvgIcon;assembly=BCCL.Core"
                   xmlns:sys="clr-namespace:System;assembly=mscorlib"
                   PanScroll="{Binding ElementName=RankingScroll}">
    <local:MyPageRight.Resources>
        <sys:Boolean x:Key="RecommendationMotionEnabled">True</sys:Boolean>
        <CornerRadius x:Key="RecommendationRadius">32</CornerRadius>
        <Style x:Key="RecommendationButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
            <Setter Property="Background" Value="{DynamicResource GlassCardFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.5"
                              Tag="{DynamicResource RecommendationMotionEnabled}">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PressScale" />
                            </Grid.RenderTransform>
                            <Border x:Name="Outline" CornerRadius="{DynamicResource RecommendationRadius}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border CornerRadius="{DynamicResource RecommendationRadius}" IsHitTestVisible="False"
                                    Background="{DynamicResource GlassCardSheen}" Opacity="0.46"
                                    Visibility="{DynamicResource LiquidGlassVisibility}" />
                            <Border x:Name="HoverGlow" CornerRadius="{DynamicResource RecommendationRadius}"
                                    Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource GlassCardSheen}"
                                    BorderBrush="{DynamicResource ColorBrush3}" BorderThickness="1" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
                                <Setter TargetName="Outline" Property="BorderThickness" Value="1.6" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition SourceName="Surface" Property="Tag">
                                        <Condition.Value><sys:Boolean>True</sys:Boolean></Condition.Value>
                                    </Condition>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                             To="0.85" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition SourceName="Surface" Property="Tag">
                                        <Condition.Value><sys:Boolean>False</sys:Boolean></Condition.Value>
                                    </Condition>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HoverGlow" Property="Opacity" Value="0.85" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsPressed" Value="True" />
                                    <Condition SourceName="Surface" Property="Tag">
                                        <Condition.Value><sys:Boolean>True</sys:Boolean></Condition.Value>
                                    </Condition>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                             To="0.975" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                             To="0.975" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.13" FillBehavior="Stop" />
                                            <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.13" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecommendationChevron" TargetType="svg:SvgIcon">
            <Setter Property="Icon" Value="lucide/chevron-right" />
            <Setter Property="IconBrush" Value="{DynamicResource ColorBrush3}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <DataTemplate x:Key="CategoryContent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="46" Height="46">
                    <Border CornerRadius="14" Background="{DynamicResource ColorBrush3}" Opacity="0.12" />
                    <Border CornerRadius="14" BorderBrush="{DynamicResource ColorBrush3}"
                            BorderThickness="1" Opacity="0.26" />
                    <svg:SvgIcon Width="25" Height="25" IconBrush="{DynamicResource ColorBrush3}"
                                 Icon="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding}" Margin="13,0,8,0"
                           VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                <svg:SvgIcon Grid.Column="2" Style="{StaticResource RecommendationChevron}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="CategoryButton" TargetType="Button" BasedOn="{StaticResource RecommendationButton}">
            <Style.Resources>
                <CornerRadius x:Key="RecommendationRadius">20</CornerRadius>
            </Style.Resources>
            <Setter Property="Height" Value="92" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContentTemplate" Value="{StaticResource CategoryContent}" />
        </Style>

        <Style x:Key="ServerCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Setter Property="Height" Value="74" />
            <Setter Property="Margin" Value="5,13,5,5" />
            <Setter Property="Background" Value="{DynamicResource GlassLeftFill}" />
        </Style>

        <DataTemplate x:Key="RecommendationRow">
            <Button Style="{StaticResource RecommendationButton}" Height="64" Click="OpenProject_Click"
                    HorizontalContentAlignment="Stretch" Padding="13,4,18,4"
                    AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42">
                        <Border CornerRadius="12" Background="{DynamicResource ColorBrush3}" Opacity="0.10" />
                        <local:MyImage Width="42" Height="42" CornerRadius="12" Stretch="Uniform" Loaded="ProjectLogo_Loaded"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Description}" Opacity="0.8" Margin="0,3,0,0" />
                    </StackPanel>
                    <svg:SvgIcon Grid.Column="2" Style="{StaticResource RecommendationChevron}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ServerRow">
            <Button Style="{StaticResource RecommendationButton}" Click="CopyServer_Click"
                    HorizontalContentAlignment="Stretch" Padding="13,4,18,4"
                    Tag="{Binding ElementName=CopyLabel}"
                    AutomationProperties.Name="{Binding Name}"
                    AutomationProperties.HelpText="{DynamicResource Instance.Server.Card.CopyAddress}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42">
                        <Image Source="{Binding Logo}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Description}" Opacity="0.8" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,3">
                            <TextBlock Text="{DynamicResource Tools.Daily.Server.Accelerator}"
                                       ToolTip="{DynamicResource Tools.Daily.Server.RegionSource}"
                                       FontSize="11" Opacity="0.8" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BasedOnTextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverseas}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding LatencyText}" FontSize="13"
                                       Margin="0,0,11,0" VerticalAlignment="Center"
                                       ToolTip="{DynamicResource Tools.Daily.Server.Latency}" />
                            <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="ToolTip" Value="{DynamicResource Tools.Daily.Server.OnlinePlayers}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayerCountIsStale}" Value="True">
                                            <Setter Property="ToolTip" Value="{DynamicResource Tools.Daily.Server.LastPlayers}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PlayerCountIsFromDirectory}" Value="True">
                                            <Setter Property="ToolTip" Value="{DynamicResource Tools.Daily.Server.DirectoryPlayers}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <svg:SvgIcon Icon="lucide/user" IconBrush="{DynamicResource ColorBrush3}"
                                         Width="14" Height="14" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding PlayerCountText}"
                                       FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <Grid HorizontalAlignment="Right">
                            <Border CornerRadius="14" Background="{DynamicResource ColorBrush3}" Opacity="0.12" />
                            <TextBlock x:Name="CopyLabel" Margin="11,4" TextAlignment="Center"
                                       Text="{DynamicResource Instance.Server.Card.CopyAddress}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </local:MyPageRight.Resources>

    <Grid Margin="24,16,24,16" ClipToBounds="True">
        <local:MyScrollViewer x:Name="CategoryPanel" MaxWidth="960"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,11,4,8">
                <StackPanel Orientation="Horizontal" Margin="5,0,5,17">
                    <Border Width="4" Height="22" CornerRadius="2" Margin="0,0,11,0"
                            Background="{DynamicResource ColorBrush3}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Tools.Daily.Title}" FontSize="27" FontWeight="SemiBold"
                               VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                </StackPanel>
                <UniformGrid x:Name="Categories" Columns="3" SizeChanged="Categories_SizeChanged" Button.Click="Category_Click">
                    <Button Style="{StaticResource CategoryButton}" CommandParameter="Mod" Tag="lucide/puzzle"
                            Content="{DynamicResource Download.Left.Mod}" />
                    <Button Style="{StaticResource CategoryButton}" CommandParameter="ModPack" Tag="lucide/package"
                            Content="{DynamicResource Download.Left.Modpack}" />
                    <Button Style="{StaticResource CategoryButton}" CommandParameter="DataPack" Tag="lucide/file-archive"
                            Content="{DynamicResource Download.Left.DataPack}" />
                    <Button Style="{StaticResource CategoryButton}" CommandParameter="ResourcePack" Tag="lucide/layers"
                            Content="{DynamicResource Download.Left.ResourcePack}" />
                    <Button Style="{StaticResource CategoryButton}" CommandParameter="Shader" Tag="lucide/sparkles"
                            Content="{DynamicResource Download.Left.Shader}" />
                    <Button Style="{StaticResource CategoryButton}" CommandParameter="World" Tag="lucide/globe"
                            Content="{DynamicResource Download.Left.World}" />
                </UniformGrid>
                <Button Style="{StaticResource ServerCategoryButton}" Tag="lucide/server"
                        Click="ServerRecommendations_Click" Content="{DynamicResource Tools.Daily.Server.Title}" />
            </StackPanel>
        </local:MyScrollViewer>

        <Grid x:Name="RankingPanel" MaxWidth="950" Margin="5,11,5,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,15">
                <Button Style="{StaticResource RecommendationButton}" Click="BackToCategories_Click"
                        Margin="0,0,13,0" MinHeight="36"
                        AutomationProperties.Name="{DynamicResource Common.Action.Back}">
                    <StackPanel Orientation="Horizontal">
                        <svg:SvgIcon Icon="lucide/arrow-left" IconBrush="{DynamicResource ColorBrush3}"
                                     Width="15" Height="15" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Common.Action.Back}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="RankingTitle" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" AutomationProperties.HeadingLevel="Level1" />
            </DockPanel>
            <DockPanel x:Name="StatusPanel" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed">
                <Button x:Name="RetryButton" Style="{StaticResource RecommendationButton}"
                        Click="Retry_Click" Content="{DynamicResource Tools.Daily.Retry}"
                        DockPanel.Dock="Right" Margin="8,0,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="RankingStatus" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.82" />
            </DockPanel>
            <local:MyScrollViewer x:Name="RankingScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Projects" Margin="0,0,4,0" />
            </local:MyScrollViewer>
            <ItemsControl x:Name="LoadingSkeleton" Grid.Row="2" Margin="0,0,4,0" Visibility="Collapsed"
                          IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="64" CornerRadius="{StaticResource RecommendationRadius}" Margin="0,0,0,7" Padding="14,0,18,0"
                                Background="{DynamicResource GlassCardFill}"
                                BorderBrush="{DynamicResource WorkbenchDivider}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="10"
                                        Background="{DynamicResource ColorBrush5}" Opacity="0.24" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Border Height="12" Width="145" HorizontalAlignment="Left" CornerRadius="6"
                                            Background="{DynamicResource ColorBrush5}" Opacity="0.26" />
                                    <Border Height="9" Width="260" HorizontalAlignment="Left" Margin="0,7,0,0" CornerRadius="4.5"
                                            Background="{DynamicResource ColorBrush5}" Opacity="0.18" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</local:MyPageRight>
