<Border x:Name="PanBack" x:Class="BCCL.MyRadioButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BCCL.Core.UI.Controls;assembly=BCCL.Core"
        xmlns:svgIcon="clr-namespace:BCCL.Core.UI.Controls.SvgIcon;assembly=BCCL.Core"
        HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource ColorBrushSemiTransparent}"
        CornerRadius="13.5" MinHeight="27" MaxHeight="27">
    <Border.RenderTransform>
        <ScaleTransform />
    </Border.RenderTransform>
    <Grid>
        <Grid x:Name="GlassSurface" IsHitTestVisible="False" Visibility="Collapsed">
            <local:LiquidGlassSurface xmlns:local="clr-namespace:BCCL" Radius="20" />
            <Border x:Name="GlassSheen" CornerRadius="20">
                <Border.Background>
                    <RadialGradientBrush Center="0.28,0.15" GradientOrigin="0.28,0.15" RadiusX="0.95" RadiusY="0.9">
                        <GradientStop Color="#50ffffff" Offset="0" />
                        <GradientStop Color="#18ffffff" Offset="0.48" />
                        <GradientStop Color="#00ffffff" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="20" BorderThickness="1.1">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#f2ffffff" Offset="0" />
                        <GradientStop Color="#35ffffff" Offset="0.48" />
                        <GradientStop Color="#a6ffffff" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
        </Grid>
        <StackPanel x:Name="PanContent" Orientation="Horizontal" VerticalAlignment="Center">
        <Grid x:Name="LogoHost"
              Width="16" Height="16"
              Margin="12,0,0,0"
              RenderTransformOrigin="0.5,0.5"
              VerticalAlignment="Center"
              HorizontalAlignment="Left">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Path x:Name="ShapeLogo"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Stretch="Uniform"
                  Fill="White" />
            <svgIcon:SvgIcon x:Name="ShapeSvgIcon"
                         Stretch="Uniform"
                         Visibility="Collapsed"
                         IconBrush="{Binding Fill, ElementName=ShapeLogo}" />
        </Grid>
        <TextBlock x:Name="LabText"
                   VerticalAlignment="Center"
                   Foreground="White"
                   Margin="8,0,12,0"
                   SnapsToDevicePixels="False"
                   UseLayoutRounding="False" />
        </StackPanel>
    </Grid>
</Border>
