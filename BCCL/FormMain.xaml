<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BCCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:BCCL.Core.UI.Controls;assembly=BCCL.Core"
    mc:Ignorable="d"
    KeyDown="FormMain_KeyDown" MouseDown="FormMain_MouseDown" SizeChanged="FormMain_SizeChanged"
    Closing="FormMain_Closing" Activated="FormMain_Activated" Drop="FrmMain_Drop" StateChanged="WindowStateChanged"
    MouseMove="FormMain_MouseMove"
    x:Name="WindMain" x:Class="BCCL.FormMain" Style="{StaticResource MyWindow}"
    AllowDrop="True" Topmost="True" Title="Boat Chris Craft Launcher" MinHeight="520" MinWidth="930"
    ScrollViewer.VerticalScrollBarVisibility="Disabled" Icon="/BCCL;component/Images/icon.ico"
    ResizeMode="CanResize" Background="{DynamicResource ColorBrushBackground}" d:DesignWidth="1040" d:DesignHeight="640" Width="1020" Height="620"
    WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="False">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ThumbnailClipMargin="{Binding Margin, ElementName=PanForm}" />
    </Window.TaskbarItemInfo>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            UseAeroCaptionButtons="False"
            ResizeBorderThickness="0"
            CornerRadius="6"
            GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="TransformRotate" Angle="0" />
                <TranslateTransform x:Name="TransformPos" X="0" Y="22" />
            </TransformGroup>
        </Grid.RenderTransform>
        <!-- Full-bleed content; WindowChrome alone owns the outer rounded region. -->
        <Border x:Name="PanBack" Margin="0">
            <Grid x:Name="PanForm" SnapsToDevicePixels="False" UseLayoutRounding="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True"
                      Visibility="{DynamicResource LiquidGlassVisibility}">
                    <Ellipse Width="650" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-200,-150,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush Opacity="0.48">
                                <GradientStop Color="{DynamicResource ColorObject4}" Offset="0" />
                                <GradientStop Color="#00c8edff" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="680" Height="500" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-200,0,0,-190">
                        <Ellipse.Fill>
                            <RadialGradientBrush Opacity="0.38">
                                <GradientStop Color="{DynamicResource ColorObject5}" Offset="0" />
                                <GradientStop Color="#00b8caff" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <Canvas x:Name="ImgBack" IsHitTestVisible="False" Grid.Row="1" Grid.Column="1" ClipToBounds="True"
                        RenderOptions.BitmapScalingMode="LowQuality">
                    <MediaElement x:Name="VideoBack" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  Width="{Binding ActualWidth, ElementName=PanMain}" Height="{Binding ActualHeight, ElementName=PanMain}"
                                  Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Visible"
                                  MediaEnded="VideoEnded" Volume="0" />
                </Canvas>
                <!-- The navigation column follows the rail as it expands and collapses. -->
                <Grid x:Name="NavigationDock" Grid.RowSpan="2" Width="76" HorizontalAlignment="Left" Panel.ZIndex="3" ClipToBounds="True"
                      Background="Transparent" MouseEnter="NavigationDock_MouseEnter" MouseLeave="NavigationDock_MouseLeave"
                      GotKeyboardFocus="NavigationDock_GotKeyboardFocus" LostKeyboardFocus="NavigationDock_LostKeyboardFocus">
                  <Canvas>
                   <local:AnimatedBackgroundGrid x:Name="PanTitle" Canvas.Left="0" Width="140"
                                              Height="{Binding ActualHeight, ElementName=NavigationDock}"
                                              BackgroundBrush="{DynamicResource WorkbenchRailFill}"
                                              SizeChanged="PanTitle_SizeChanged" MouseLeftButtonDown="FormDragMove">
                    <local:AnimatedBackgroundGrid.RenderTransform><TranslateTransform x:Name="NavigationSlide" X="0" /></local:AnimatedBackgroundGrid.RenderTransform>
                    <local:MyImage x:Name="ImgTitle" IsHitTestVisible="False" Stretch="UniformToFill" IsEnabled="False"
                                   RenderOptions.BitmapScalingMode="LowQuality" />

                    <Border BorderBrush="{DynamicResource WorkbenchDivider}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                    <Grid x:Name="PanNavigation" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="PanTitleLeft" Grid.Row="0" Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" x:Name="ShapeTitleLogo" Source="/BCCL;component/Images/icon.png" Width="46" Height="46" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="BCCL Logo" />
                            <Path Grid.Column="0" x:Name="ShapeHMCLTitleLogo" Data="M 60.375 53.406 L 53.625 53.406 L 53.625 0.906 L 63.6 0.906 L 78.15 34.131 L 92.475 0.906 L 102.675 0.906 L 102.675 53.406 L 95.55 53.406 L 95.55 9.981 L 81.525 41.556 L 74.475 41.556 L 60.375 9.981 L 60.375 53.406 Z M 7.125 53.406 L 0 53.406 L 0 0.906 L 7.125 0.906 L 7.125 23.331 L 33 23.331 L 33 0.906 L 40.125 0.906 L 40.125 53.406 L 33 53.406 L 33 29.481 L 7.125 29.481 L 7.125 53.406 Z M 149.85 2.706 L 147.675 8.706 Q 145.35 7.581 142.913 6.906 Q 140.475 6.231 137.175 6.231 Q 132.375 6.231 128.588 8.706 Q 124.8 11.181 122.625 15.831 A 25.755 25.755 0 0 0 120.458 26.263 A 38.963 38.963 0 0 0 120.45 27.081 Q 120.45 33.381 122.588 38.106 Q 124.725 42.831 128.512 45.456 Q 132.3 48.081 137.175 48.081 Q 140.85 48.081 143.55 47.181 Q 146.25 46.281 148.8 44.856 L 150.975 50.781 Q 148.2 52.281 144.638 53.293 Q 141.075 54.306 136.35 54.306 Q 129.525 54.306 124.275 51.043 Q 119.025 47.781 116.1 41.743 A 31.603 31.603 0 0 1 113.201 28.922 A 45.601 45.601 0 0 1 113.175 27.381 Q 113.175 19.356 116.138 13.168 Q 119.1 6.981 124.538 3.493 Q 129.975 0.006 137.25 0.006 Q 141 0.006 144.075 0.718 Q 147.15 1.431 149.85 2.706 Z M 191.925 53.406 L 160.725 53.406 L 160.725 0.906 L 167.85 0.906 L 167.85 47.031 L 191.925 47.031 L 191.925 53.406 Z"
                                StrokeThickness="0.2" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" HorizontalAlignment="Center" Height="15" Margin="0" Stretch="Fill" Stroke="White" Fill="White" Width="52" />
                            <TextBlock Grid.Column="0" x:Name="LabTitleLogo" Visibility="Collapsed" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" HorizontalAlignment="Center" Margin="0" Foreground="{DynamicResource GlassNavigationForeground}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <local:MyImage Grid.Column="0" x:Name="ImageTitleLogo" MaxWidth="88" MaxHeight="36" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="LabNavigationBrand" Grid.Row="0" Text="BCCL" Visibility="{Binding Visibility, ElementName=ShapeTitleLogo}" FontSize="18" FontWeight="SemiBold" Margin="76,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray1}" IsHitTestVisible="False" />
                        <ScrollViewer Grid.Row="1" Width="{Binding ActualWidth, ElementName=NavigationDock}" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="0" Focusable="False">
                            <StackPanel x:Name="PanTitleSelect" Margin="12,14,12,14" Orientation="Vertical"
                                        KeyboardNavigation.TabNavigation="Continue">
                                <local:MyRadioButton x:Name="BtnTitleSelect0" Text="{DynamicResource Workbench.Title}" Tag="0"
                                                     Checked="True" IsNavigationItem="True" Height="44"
                                                     Margin="0,0,0,8" Check="BtnTitleSelect_Click" SvgIcon="lucide/play" />
                                <local:MyRadioButton x:Name="BtnTitleSelect1" Text="{DynamicResource Main.Tab.Download}" Tag="1"
                                                     IsNavigationItem="True" Height="44"
                                                     Margin="0,0,0,8" Check="BtnTitleSelect_Click" SvgIcon="lucide/download" />
                                <local:MyRadioButton x:Name="BtnTitleSelect2" Text="{DynamicResource Main.Tab.Settings}" Tag="2"
                                                     IsNavigationItem="True" Height="44"
                                                     Margin="0,0,0,8" Check="BtnTitleSelect_Click" SvgIcon="lucide/settings" />
                                <local:MyRadioButton x:Name="BtnTitleSelect3" Text="{DynamicResource Main.Tab.Tools}" Tag="3"
                                                     IsNavigationItem="True" Height="44"
                                                     Margin="0,0,0,8" Check="BtnTitleSelect_Click" SvgIcon="lucide/wrench" />
                                <local:MyRadioButton x:Name="BtnTitleSelect4" Text="联机" Tag="4"
                                                     IsNavigationItem="True" Height="44"
                                                     Margin="0,0,0,8" Check="BtnTitleSelect_Click" SvgIcon="lucide/network" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                   </local:AnimatedBackgroundGrid>
                  </Canvas>
                  <Border x:Name="NavigationEdge" Width="24" Height="3" CornerRadius="1.5" Margin="26,0,0,24"
                          Background="{DynamicResource ColorBrush3}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          IsHitTestVisible="False" />
                </Grid>
                <local:AnimatedBackgroundGrid x:Name="WindowTitleBar" Height="78" Grid.Row="0" Grid.Column="1"
                                              BackgroundBrush="{DynamicResource GlassHeaderBackground}"
                                              MouseLeftButtonDown="FormDragMove" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border BorderBrush="{DynamicResource WorkbenchDivider}" BorderThickness="0,0,0,1" IsHitTestVisible="False" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,100,0">
                        <Border CornerRadius="10" Padding="12,6" Background="{DynamicResource WorkbenchAccentFill}">
                            <TextBlock Text="{DynamicResource Workbench.Header}" FontSize="11" Foreground="{DynamicResource ColorBrush2}" />
                        </Border>
                    </StackPanel>
                    <Grid x:Name="PanTitleMain">
                        <TextBlock x:Name="LabPageTitle" Text="{DynamicResource Workbench.Title}" Margin="26,0,300,0"
                                   IsHitTestVisible="False" VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" />
                    </Grid>
                    <Grid x:Name="PanTitleInner" Visibility="Collapsed" Margin="-16,0,0,0" Opacity="0"
                          HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=WindowTitleBar, Mode=OneWay}">
                        <local:MyIconButton HorizontalAlignment="Left" x:Name="BtnTitleInner" Theme="Color"
                                            Margin="22,0,0,0" Height="28" Width="28" Click="BtnTitleInner_Click"
                                            LogoScale="0.87" SvgIcon="lucide/arrow-left" />
                        <TextBlock SnapsToDevicePixels="False" IsHitTestVisible="False" Name="LabTitleInner"
                                   VerticalAlignment="Center" Margin="60,1,240,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrush1}" FontSize="14" />
                    </Grid>
                    <local:MyIconButton x:Name="BtnTitleClose" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Height="28" Width="28" Margin="0,0,22,0" Theme="Black" Click="BtnTitleClose_Click"
                                        ToolTip="{DynamicResource Common.Action.Close}" SvgIcon="lucide/x" />
                    <local:MyIconButton x:Name="BtnTitleMin" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Height="28" Width="28" Margin="0,0,58,0" Theme="Black" Click="BtnTitleMin_Click"
                                        SvgIcon="lucide/minus" />
                    <local:MyIconButton x:Name="BtnTitleHelp" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Height="28" Width="28" Margin="0,0,94,0" Theme="Black" Visibility="Collapsed"
                                        Click="BtnTitleHelp_Click" SvgIcon="lucide/circle-help" />
                </local:AnimatedBackgroundGrid>
                <Grid x:Name="PanLeft" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Left" SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <controls:BlurBorder IsHitTestVisible="False" BlurRadius="{DynamicResource GlassCardBlurRadius}">
                        <local:AnimatedBackgroundGrid x:Name="RectLeftBackground" Width="0"
                                                      BackgroundBrush="{DynamicResource GlassLeftFill}" />
                    </controls:BlurBorder>
                    <Rectangle x:Name="RectLeftShadow" Width="4" HorizontalAlignment="Left" IsHitTestVisible="False"
                               Grid.Column="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0" Opacity="0.04">
                                <GradientStop Color="#000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <Border x:Name="WorkspaceViewport" Grid.Row="1" Grid.Column="1" ClipToBounds="True">
                <Grid x:Name="PanMain" VerticalAlignment="Top" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="WorkspaceContextColumn" Width="Auto" />
                        <ColumnDefinition x:Name="WorkspaceContentColumn" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="WorkspaceContent" Grid.Column="1" Grid.IsSharedSizeScope="True" UseLayoutRounding="True"
                            SnapsToDevicePixels="True">
                        <Border x:Name="PanMainRight" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                UseLayoutRounding="False" SnapsToDevicePixels="False" />
                    </Border>
                    <Border x:Name="WorkspaceContext" Grid.Column="0" CornerRadius="20" Margin="16,16,0,16" Background="{DynamicResource WorkbenchContextFill}" BorderBrush="{DynamicResource WorkbenchDivider}" BorderThickness="1" Grid.IsSharedSizeScope="True" UseLayoutRounding="True"
                            SnapsToDevicePixels="True">
                        <Border x:Name="PanMainLeft" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                SizeChanged="PanMainLeft_SizeChanged"
                                UseLayoutRounding="False" SnapsToDevicePixels="False" />
                    </Border>
                </Grid>
                </Border>
                <StackPanel x:Name="PanHint" UseLayoutRounding="True"
                            SnapsToDevicePixels="True" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,0,20"
                            Grid.Row="1" Grid.Column="1" Panel.ZIndex="4" />
                <StackPanel x:Name="PanExtraButtons" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="1" Grid.Column="1" Margin="15">
                    <local:MyExtraButton x:Name="BtnExtraUpdateRestart" HorizontalAlignment="Right"
                                         Click="BtnExtraUpdateRestart_Click"
                                         VerticalAlignment="Center" ToolTip="{DynamicResource Main.Extra.UpdateRestart.ToolTip}"
                                         Visibility="Collapsed"
                                         SvgIcon="lucide/refresh-cw" />
                    <local:MyExtraButton x:Name="BtnExtraBack" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Click="BtnExtraBack_Click"
                                         ToolTip="{DynamicResource Main.Extra.BackToTop.ToolTip}" Visibility="Collapsed"
                                         SvgIcon="lucide/arrow-up-to-line" />
                    <local:MyExtraButton x:Name="BtnExtraDownload" HorizontalAlignment="Right"
                                         Click="BtnExtraDownload_Click"
                                         VerticalAlignment="Center" ToolTip="{DynamicResource Main.Extra.TaskManager.ToolTip}" Visibility="Collapsed"
                                         SvgIcon="lucide/download" />
                    <local:MyExtraButton x:Name="BtnExtraApril" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Click="BtnExtraApril_Click"
                                         ToolTip="{DynamicResource Main.Extra.GiveUp.ToolTip}" Visibility="Collapsed"
                                         SvgIcon="lucide/flag" />
                    <local:MyExtraButton x:Name="BtnExtraShutdown" HorizontalAlignment="Right"
                                         Click="BtnExtraShutdown_Click"
                                         VerticalAlignment="Center" ToolTip="{DynamicResource Main.Extra.ShutdownMinecraft.ToolTip}" Visibility="Collapsed"
                                         SvgIcon="lucide/power" />
                    <local:MyExtraButton x:Name="BtnExtraLog" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Click="BtnExtraLog_Click"
                                         ToolTip="{DynamicResource Main.Extra.GameLog.ToolTip}" Visibility="Collapsed"
                                         SvgIcon="lucide/scroll-text" />
                    <local:MyExtraButton x:Name="BtnExtraMusic" HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Click="BtnExtraMusic_Click" RightClick="BtnExtraMusic_RightClick"
                                         Visibility="Collapsed" CanRightClick="True" />
                </StackPanel>
                <Border Grid.RowSpan="2" Grid.ColumnSpan="2" CornerRadius="6" BorderThickness="1" Margin="0.5"
                        BorderBrush="{DynamicResource GlassEdgeBrush}" IsHitTestVisible="False" Panel.ZIndex="1"
                        Visibility="{DynamicResource LiquidGlassVisibility}" />
                <controls:BlurBorder x:Name="PanMsgBackground" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#00000000"
                                     Panel.ZIndex="2" Visibility="Collapsed">
                    <Grid x:Name="PanMsg" Background="#00000000" MouseLeftButtonDown="FormDragMove" />
                </controls:BlurBorder>
            </Grid>
        </Border>
    </Grid>
</Window>
